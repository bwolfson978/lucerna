# Backend settings. Every variable is optional locally; app/config.py declares each one
# with its type and default, and is the only place the backend reads the environment.
# Production values live in Railway (service "lucerna").

# --- Website
SITE_URL=https://www.rothconversionsoptimizer.com
# Comma-separated frontend origins for CORS. Empty means http://localhost:3000.
ALLOWED_ORIGINS=

# --- Storage and operations
# Empty: saved-scenario endpoints return 503.
DATABASE_URL=
# Empty: /metrics is open.
METRICS_TOKEN=
OPENAI_APPS_CHALLENGE=
# Set by Railway itself.
RAILWAY_ENVIRONMENT_NAME=local
RAILWAY_GIT_COMMIT_SHA=

# --- Sign-in (Clerk)
# Comma-separated JWKS URLs.
CLERK_JWKS_URL=
CLERK_SECRET_KEY=

# --- MCP server
# Empty: OAuth for the save/list/open tools is off.
MCP_AUTH_ISSUER=
MCP_AUTH_SCOPES=profile email
MCP_INTERNAL_TOKEN=
MCP_ANALYSES_PER_IP_PER_DAY=25
MCP_ANALYSES_PER_USER_PER_DAY=100
MCP_ANONYMOUS_ANALYSES_PER_DAY=3000
MCP_MAX_CONCURRENT_ANALYSES=2
MCP_ANALYSIS_QUEUE_SECONDS=10

# --- Website assistant
ANTHROPIC_API_KEY=
# Used when ANTHROPIC_API_KEY is reserved by the environment.
LUCERNA_ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
# 1: scripted replies, no model calls.
AGENT_OFFLINE=
# Empty: the assistant's tools run in process.
AGENT_MCP_URL=
# Where the generated /demo conversation is cached. Empty: backend/.cache.
AGENT_CACHE_DIR=
AGENT_MESSAGES_PER_CONVERSATION=20
AGENT_MESSAGES_PER_IP_PER_DAY=60
AGENT_DAILY_SPEND_USD=50

# --- Feedback and analytics (PostHog)
FEEDBACK_PER_CALLER_PER_DAY=10
FEEDBACK_PER_DAY=500
# Empty: error tracking and analytics events are off.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Data deletion (scripts/delete_user_data.py).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com
